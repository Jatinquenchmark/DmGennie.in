{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/auth/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/webhook",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/dist/index.html"
        }
    ]
}