{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/admin/:action", "destination": "/api/admin?action=:action" },
    { "source": "/api/billing/:action", "destination": "/api/billing?action=:action" },
    { "source": "/api/dashboard/metrics", "destination": "/api/dashboard?action=metrics" },
    { "source": "/api/settings", "destination": "/api/me?action=settings" },
    { "source": "/api/triggers/:id", "destination": "/api/triggers?id=:id" },
    { "source": "/api/instagram/profile", "destination": "/api/auth?action=profile" },
    { "source": "/auth/instagram/callback", "destination": "/api/auth?action=callback" },
    { "source": "/auth/instagram/disconnect", "destination": "/api/auth?action=disconnect" },
    { "source": "/auth/instagram", "destination": "/api/auth?action=instagram" },
    { "source": "/webhook", "destination": "/api/webhook" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
