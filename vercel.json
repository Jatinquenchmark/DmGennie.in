{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        },
        {
            "source": "/auth/:path*",
            "destination": "/api/auth/:path*"
        },
        {
            "source": "/webhook",
            "destination": "/api/webhook"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}