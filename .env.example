# ── Supabase (Frontend) ───────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Dev master-access gate (frontend; dev.dmgennie.in only) ─
# Note: VITE_* vars are embedded in the client bundle at build time and are NOT
# secret. This gate is a dev-deployment convenience, not a real security control.
VITE_MASTER_EMAIL=admin@dmgennie.in
VITE_MASTER_PASSWORD=change_this_strong_password

# ── Backend (Server) ──────────────────────────────────────
PORT=3000
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Meta / Instagram webhook (server only) ────────────────
# REQUIRED. The webhook fails closed without these:
#  - WEBHOOK_VERIFY_TOKEN: an arbitrary high-entropy string; must match the value
#    configured in the Meta App webhook subscription. No default is used.
#  - META_APP_SECRET: the Meta App secret, used to validate X-Hub-Signature-256
#    on every incoming event. Without it, all webhook POSTs are rejected (401).
WEBHOOK_VERIFY_TOKEN=generate_a_long_random_string
META_APP_SECRET=your-meta-app-secret

# ── Admin Seed (server only; never expose in frontend) ────
ADMIN_EMAIL=admin@dmgennie.in
ADMIN_PASSWORD=change_this_strong_password

# ── Billing / Razorpay (server only) ──────────────────────
# The Pro plan renews at the configured monthly plan amount.
PRO_MONTHLY_PRICE_INR=499
PRO_ANNUAL_MONTHLY_PRICE_INR=399
PRO_INTRO_FIRST_MONTH_INR=1
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret
RAZORPAY_PRO_MONTHLY_PLAN_ID=plan_xxxxxxxxx
RAZORPAY_PRO_INTRO_OFFER_ID=offer_xxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
