# ── Supabase (Frontend) ───────────────────────────────────
# Get these from: https://supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Backend (Server) ──────────────────────────────────────
PORT=3000
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
APP_URL=https://dm-gennie-in.vercel.app
FRONTEND_URL=https://dm-gennie-in.vercel.app

# ── Instagram Login OAuth (server only) ───────────────────
INSTAGRAM_CLIENT_ID=1294861889046476
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret
INSTAGRAM_REDIRECT_URI=https://dm-gennie-in.vercel.app/auth/instagram/callback
NEXT_PUBLIC_APP_URL=https://dm-gennie-in.vercel.app
WEBHOOK_VERIFY_TOKEN=dmgennie_verify_token_123

# ── Meta / Instagram webhook (server only) ────────────────
# REQUIRED. The webhook fails closed without these:
#  - WEBHOOK_VERIFY_TOKEN: an arbitrary high-entropy string; must match the value
#    configured in the Meta App webhook subscription. No default is used.
#  - META_APP_SECRET: the Meta App secret, used to validate X-Hub-Signature-256
#    on every incoming event. Without it, all webhook POSTs are rejected (401).
WEBHOOK_VERIFY_TOKEN=generate_a_long_random_string
META_APP_SECRET=your-meta-app-secret

# OAUTH_STATE_SECRET: signs the Instagram OAuth `state` param (CSRF protection).
# Use a dedicated high-entropy value so it isn't shared with META_APP_SECRET or the
# service-role key. Falls back to META_APP_SECRET if unset.
OAUTH_STATE_SECRET=generate_a_long_random_string

# ── Admin Seed (server only; never expose in frontend) ────
ADMIN_EMAIL=admin@dmgennie.in
ADMIN_PASSWORD=change_this_strong_password

# ── Billing / Razorpay ────────────────────────────────────
# The Pro plan renews at the configured monthly plan amount.
PRO_MONTHLY_PRICE_INR=499
PRO_ANNUAL_MONTHLY_PRICE_INR=399
PRO_INTRO_FIRST_MONTH_INR=1
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_PRO_MONTHLY_PLAN_ID=plan_T3Eh01YnuLdoWF
# Optional. Checkout continues at the normal plan price when omitted.
RAZORPAY_PRO_FIRST_MONTH_OFFER_ID=offer_xxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret
